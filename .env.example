# Agents require a real Pi session; disabled models return an explicit error.
PI_AGENT_ENABLED=true

# Kimi Code is built into the installed Pi provider catalog.
PI_MODEL_PROVIDER=kimi-coding
PI_MODEL=kimi-for-coding
KIMI_API_KEY=replace-with-your-kimi-code-key

# Thinking is off by default; the Web composer can explicitly enable minimal thinking per turn.
# PI_THINKING_LEVEL=off

# Project TypeScript extensions are official Pi resources but execute in the API
# process. Keep disabled unless every file under .pi/extensions has been reviewed.
# PI_PROJECT_EXTENSIONS_ENABLED=true
