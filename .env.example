# Require a Feishu login before the Web workbench can be used.
AUTH_REQUIRED=true

# Feishu custom app credentials. Keep these in the API environment only.
# FEISHU_APP_ID=cli_xxxxxxxxxxxxx
# FEISHU_APP_SECRET=replace-with-your-feishu-app-secret
# Register this exact URL in the Feishu app's security settings.
# FEISHU_REDIRECT_URI=http://localhost:5173/api/v1/auth/feishu/callback
# Optional least-privilege scope list, separated by spaces.
# FEISHU_SCOPE=contact:user.base:readonly

# Enable the real Pi session instead of the deterministic local fallback.
PI_AGENT_ENABLED=true

# Kimi Code is built into the installed Pi provider catalog.
PI_MODEL_PROVIDER=kimi-coding
PI_MODEL=kimi-for-coding
KIMI_API_KEY=replace-with-your-kimi-code-key

# Optional: minimal is the default for low-latency knowledge Q&A; use off for lookup-only turns.
# PI_THINKING_LEVEL=minimal

# Project TypeScript extensions are official Pi resources but execute in the API
# process. Keep disabled unless every file under .pi/extensions has been reviewed.
# PI_PROJECT_EXTENSIONS_ENABLED=true

# Local workspace data (SQLite by default; use memory only for tests).
# PI_WORKSPACE_DB_MODE=sqlite
# PI_WORKSPACE_DB_PATH=.data/pi-workspace.sqlite
# PI_WORKSPACE_KNOWLEDGE_DIR=.pi/knowledge
# PI_KNOWLEDGE_REFRESH_INTERVAL_MS=750
