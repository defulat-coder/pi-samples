{
  "name": "@pi-workbench/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "portless": {
    "name": "api.pi-workbench",
    "script": "dev:app",
    "appPort": 4310
  },
  "scripts": {
    "dev": "portless",
    "dev:app": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"dist/**/*.test.js\"",
    "lint": "tsc -p tsconfig.json --noEmit && eslint --config ../../eslint.config.js src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@pi-workbench/contracts": "workspace:*",
    "@pi-workbench/pi-agent": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "env-schema": "^8.0.0",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@pi-workbench/eslint": "workspace:*",
    "eslint": "^10.9.0",
    "tsx": "^4.23.12"
  }
}
