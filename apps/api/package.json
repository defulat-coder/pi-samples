{
  "name": "@pi-workbench/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/**/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.2",
    "@pi-workbench/contracts": "workspace:*",
    "@pi-workbench/workspace-data": "workspace:*",
    "@pi-workbench/pi-agent": "workspace:*",
    "@sinclair/typebox": "^0.34.41",
    "env-schema": "^6.0.1",
    "fastify": "^5.4.0"
  },
  "devDependencies": {
    "tsx": "^4.20.3"
  }
}
