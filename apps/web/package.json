{
  "name": "@pi-workbench/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "portless": {
    "name": "pi-workbench",
    "script": "dev:app",
    "appPort": 5173
  },
  "scripts": {
    "dev": "portless",
    "dev:app": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@pi-workbench/contracts": "workspace:*",
    "motion": "13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "tsx": "^4.23.12",
    "vite": "^8.2.2"
  }
}
