{
  "name": "pi-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Fleet-style multi-agent chat workbench powered by Pi Coding Agent",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:direct": "PORTLESS=0 turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "portless": "^0.15.5",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2"
  }
}
