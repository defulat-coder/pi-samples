{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "shardId",
    "from",
    "to",
    "scenarioName",
    "narrative",
    "regionWeights",
    "channelWeights",
    "categoryWeights",
    "monthWeights",
    "refundAdjustmentsBps",
    "anomalies"
  ],
  "properties": {
    "shardId": { "type": "integer", "minimum": 1, "maximum": 20 },
    "from": { "type": "string", "pattern": "^202[5-6]-[0-1][0-9]-[0-3][0-9]$" },
    "to": { "type": "string", "pattern": "^202[5-6]-[0-1][0-9]-[0-3][0-9]$" },
    "scenarioName": { "type": "string", "minLength": 4, "maxLength": 50 },
    "narrative": { "type": "string", "minLength": 30, "maxLength": 240 },
    "regionWeights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["华东", "华南", "华北", "华中", "西部", "东北"],
      "properties": {
        "华东": { "type": "number", "minimum": 0.7, "maximum": 1.4 },
        "华南": { "type": "number", "minimum": 0.7, "maximum": 1.4 },
        "华北": { "type": "number", "minimum": 0.7, "maximum": 1.4 },
        "华中": { "type": "number", "minimum": 0.7, "maximum": 1.4 },
        "西部": { "type": "number", "minimum": 0.7, "maximum": 1.4 },
        "东北": { "type": "number", "minimum": 0.7, "maximum": 1.4 }
      }
    },
    "channelWeights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["直营网店", "平台电商", "直播", "内容电商"],
      "properties": {
        "直营网店": { "type": "number", "minimum": 0.7, "maximum": 1.4 },
        "平台电商": { "type": "number", "minimum": 0.7, "maximum": 1.4 },
        "直播": { "type": "number", "minimum": 0.7, "maximum": 1.4 },
        "内容电商": { "type": "number", "minimum": 0.7, "maximum": 1.4 }
      }
    },
    "categoryWeights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["数码家电", "家居生活", "美妆个护", "食品饮料", "服饰鞋包", "运动户外"],
      "properties": {
        "数码家电": { "type": "number", "minimum": 0.7, "maximum": 1.4 },
        "家居生活": { "type": "number", "minimum": 0.7, "maximum": 1.4 },
        "美妆个护": { "type": "number", "minimum": 0.7, "maximum": 1.4 },
        "食品饮料": { "type": "number", "minimum": 0.7, "maximum": 1.4 },
        "服饰鞋包": { "type": "number", "minimum": 0.7, "maximum": 1.4 },
        "运动户外": { "type": "number", "minimum": 0.7, "maximum": 1.4 }
      }
    },
    "monthWeights": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": { "type": "number", "minimum": 0.75, "maximum": 1.35 }
    },
    "refundAdjustmentsBps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["数码家电", "家居生活", "美妆个护", "食品饮料", "服饰鞋包", "运动户外"],
      "properties": {
        "数码家电": { "type": "integer", "minimum": -250, "maximum": 400 },
        "家居生活": { "type": "integer", "minimum": -250, "maximum": 400 },
        "美妆个护": { "type": "integer", "minimum": -250, "maximum": 400 },
        "食品饮料": { "type": "integer", "minimum": -250, "maximum": 400 },
        "服饰鞋包": { "type": "integer", "minimum": -250, "maximum": 400 },
        "运动户外": { "type": "integer", "minimum": -250, "maximum": 400 }
      }
    },
    "anomalies": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["month", "region", "channel", "category", "salesMultiplier", "refundBpsDelta", "reason"],
        "properties": {
          "month": { "type": "integer", "minimum": 1, "maximum": 12 },
          "region": { "type": "string", "enum": ["华东", "华南", "华北", "华中", "西部", "东北"] },
          "channel": { "type": "string", "enum": ["直营网店", "平台电商", "直播", "内容电商"] },
          "category": { "type": "string", "enum": ["数码家电", "家居生活", "美妆个护", "食品饮料", "服饰鞋包", "运动户外"] },
          "salesMultiplier": { "type": "number", "minimum": 0.7, "maximum": 1.5 },
          "refundBpsDelta": { "type": "integer", "minimum": -250, "maximum": 400 },
          "reason": { "type": "string", "minLength": 10, "maxLength": 120 }
        }
      }
    }
  }
}
